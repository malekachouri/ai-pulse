# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Database / cache. docker-compose builds DATABASE_URL from the POSTGRES_* values.
POSTGRES_USER=aipulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aipulse
# Used when running the API outside Docker:
DATABASE_URL=postgresql+asyncpg://aipulse:change-me-local-only@localhost:5432/aipulse
REDIS_URL=redis://localhost:6379/0

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Set to false only for plain-http local development
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
# Local dev without an email server only. Rejected when ENVIRONMENT=production.
EXPOSE_RESET_TOKEN=false

# AI providers (phase 5): openai | ollama | anthropic | none
LLM_PROVIDER=none
LLM_MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Data source credentials (phase 4; optional, raise rate limits)
GITHUB_TOKEN=
NVD_API_KEY=
