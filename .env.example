# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Database / cache. docker-compose builds DATABASE_URL from the POSTGRES_* values.
POSTGRES_USER=aipulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aipulse
# Used when running the API outside Docker:
DATABASE_URL=postgresql+asyncpg://aipulse:change-me-local-only@localhost:5432/aipulse
REDIS_URL=redis://localhost:6379/0

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Set to false only for plain-http local development
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
# Local dev without an email server only. Rejected when ENVIRONMENT=production.
EXPOSE_RESET_TOKEN=false

# AI engine (see docs/AI.md). Nothing is hardcoded: choose provider AND model.
LLM_PROVIDER=none                 # openai | anthropic | ollama | none
LLM_MODEL=                        # model id for that provider
EMBEDDING_PROVIDER=auto           # auto | openai | ollama | none  (Anthropic has no embeddings)
EMBEDDING_MODEL=                  # must yield 768 dims (OpenAI text-embedding-3-* or Ollama nomic-embed-text)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_PRICE_INPUT_PER_MTOK=         # optional USD per million tokens, for cost tracking
LLM_PRICE_OUTPUT_PER_MTOK=
AI_BATCH_SIZE=20                  # LLM analyses per scheduled run (most important first)
AI_DAILY_TOKEN_BUDGET=            # optional daily cap; empty = unlimited

# Ingestion (Celery workers + Beat)
INGESTION_MAX_ATTEMPTS=3          # job-level attempts; each HTTP request also retries with backoff
INGESTION_DISPATCH_SECONDS=60     # how often Beat looks for due sources

# Data source credentials - optional, but they raise rate limits:
#   GITHUB_TOKEN: fine-grained token with *public repository read-only* access (60 -> 5,000 req/h)
#   NVD_API_KEY:  free key from https://nvd.nist.gov/developers/request-an-api-key (5 -> 50 req / 30 s)
GITHUB_TOKEN=
NVD_API_KEY=
