# AI Pulse - configuration for docker compose (copy to .env).
#
# SECRETS DO NOT GO HERE. Passwords, JWT secret, API keys and connection strings are files in ./secrets
# (create them with ./scripts/generate-secrets.sh, then put optional third-party keys in their files).
# Every setting below can also be set as an environment variable. Empty values are ignored.
# Running the backend outside Docker? Use backend/.env.example instead.

# ---------------------------------------------------------------- deployment
# development | staging | production (production enforces safe settings)
ENVIRONMENT=production
# e.g. ghcr.io/<owner>/ai-pulse when pulling released images
IMAGE_PREFIX=ai-pulse
# git SHA or version tag in production
IMAGE_TAG=local
# host interface for the web container (keep 127.0.0.1 behind a proxy)
WEB_BIND=127.0.0.1
WEB_PORT=3000
# public hostname for the "edge" profile (Caddy, automatic HTTPS); empty = localhost with Caddy's local CA
DOMAIN=
# web <-> api network; api trusts X-Forwarded-For only from it
FRONTEND_SUBNET=172.30.10.0/24
# fixed IP of the Caddy edge inside FRONTEND_SUBNET: the only proxy the API trusts for X-Forwarded-For
EDGE_IP=172.30.10.10
# production override only
API_REPLICAS=2
WORKER_REPLICAS=1

# ---------------------------------------------------------------- application
LOG_LEVEL=INFO
POSTGRES_DB=aipulse
# least-privilege role the application uses (created on first boot)
APP_DB_USER=aipulse
# refresh cookie over HTTPS only (browsers also accept it on http://localhost)
COOKIE_SECURE=true
# the public URL(s); the web app itself calls the API same-origin
CORS_ORIGINS=["https://pulse.example.com"]
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Rate limits: "<count>/<second|minute|hour>", per client IP (or per signed-in user for search/AI)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=600/minute
# login, register, password change/reset
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SEARCH=60/minute
# Ask AI Pulse, on-demand briefing generation
RATE_LIMIT_AI=10/minute

# ---------------------------------------------------------------- AI engine (see docs/AI.md)
# openai | anthropic | ollama | none   (keys: secrets/openai_api_key, secrets/anthropic_api_key)
LLM_PROVIDER=none
# model id for that provider
LLM_MODEL=
# auto | openai | ollama | none (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=auto
# must produce 768 dimensions
EMBEDDING_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
# optional USD per million tokens, for cost tracking
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
AI_BATCH_SIZE=20
# optional daily cap; empty = unlimited
AI_DAILY_TOKEN_BUDGET=

# ---------------------------------------------------------------- email (password reset)
# Without SMTP_HOST no email is sent (the API logs a warning in production). Password: secrets/smtp_password
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
# e.g. AI Pulse <no-reply@pulse.example.com>
SMTP_FROM=
# public address of the web app for links in emails, e.g. https://pulse.example.com
PUBLIC_URL=

# ---------------------------------------------------------------- scheduling
INGESTION_MAX_ATTEMPTS=3
INGESTION_DISPATCH_SECONDS=60
BRIEFING_DISPATCH_SECONDS=300
BRIEFING_MAX_RETRIES=3
ALERTS_INTERVAL_SECONDS=300

# ---------------------------------------------------------------- monitoring & backups (profiles)
PROMETHEUS_RETENTION=30d
GRAFANA_ROOT_URL=http://localhost:3001
# named volume by default; or a host directory owned by UID 999 (chown 999:999 /srv/ai-pulse-backups)
BACKUP_DIR=pgbackups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------- tuning (defaults shown; uncomment to change)
# SQLAlchemy pool per process (each api replica and worker)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# PASSWORD_RESET_TTL_MINUTES=30
# refresh cookie SameSite: strict | lax
# COOKIE_SAMESITE=strict
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_OUTPUT_TOKENS=1800
# dropped automatically for OpenAI models that only accept the default temperature
# LLM_TEMPERATURE=0.2
# ANTHROPIC_API_URL=https://api.anthropic.com
# development only (refused in production): return password-reset tokens in the API response
# EXPOSE_RESET_TOKEN=false
