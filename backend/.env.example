# Running the API / workers directly on your machine (not in Docker): copy to backend/.env.
# Never commit .env. In Docker, secrets come from ./secrets files instead (see the root .env.example).
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://aipulse:change-me-local-only@localhost:5432/aipulse
REDIS_URL=redis://localhost:6379/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# plain-http local development only
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
# true only without an email server; rejected in production
EXPOSE_RESET_TOKEN=false

LLM_PROVIDER=none
LLM_MODEL=
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional, raise source rate limits
GITHUB_TOKEN=
NVD_API_KEY=
# set to require "Authorization: Bearer <token>" on /metrics
METRICS_TOKEN=
