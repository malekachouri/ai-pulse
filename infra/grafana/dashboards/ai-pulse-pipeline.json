      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "project": true
            },
            "renameByName": {
              "Value #A": "Up",
              "Value #B": "Consecutive failures",
              "Value #C": "Seconds since success",
              "source": "Source",
              "connector": "Connector"
            }
